    "/api/v1/media/{mediaItemId}/collections": {
      "get": {
        "summary": "The collections a title belongs to. Without it a film page cannot say\n\"part of the Alien saga\" nor link to the rest of it - the one place a\nviewer actually wonders about it.",
        "operationId": "CollectionService_ListCollectionsForMediaItem",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListCollectionsForMediaItemResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "mediaItemId",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "CollectionService"
        ]
      }
    }
