{
  "expo": {
    "name": "Evey TV",
    "slug": "evey-tv",
    "version": "0.2.12",
    "scheme": "evey",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "com.evey.tv",
      "isAppleTVOnly": true
    },
    "android": {
      "package": "com.evey.app",
      "versionCode": 112,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "backgroundColor": "#0A0A0A"
      }
    },
    "plugins": [
      "./plugins/withCleartextTraffic",
      "./plugins/withReleaseSigning",
      "./plugins/withR8Minify",
      "./plugins/withoutDeprecatedEdgeToEdge",
      [
        "./plugins/withUiScale",
        {
          "defaultPercent": 80
        }
      ],
      "./plugins/withSearchKey",
      "./plugins/withCastConnect",
      "./plugins/withNoAdId",
      "./plugins/withoutOfflineAudioService",
      "./plugins/withTvHardwareFeatures",
      "./plugins/withWidgetFocusGuard",
      "./plugins/withNoWindowBackground",
      "./plugins/withClientUpdateCheck",
      "expo-router",
      "expo-video",
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true,
          "androidTVRequired": true,
          "androidTVBanner": "./assets/tv_banner.png"
        }
      ]
    ],
    "runtimeVersion": "tv-1",
    "updates": {
      "url": "https://updates.invalid/",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "codeSigningCertificate": "../../client-updates/certificate.pem",
      "codeSigningMetadata": {
        "keyid": "main",
        "alg": "rsa-v1_5-sha256"
      },
      "disableAntiBrickingMeasures": true
    }
  }
}
