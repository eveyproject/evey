    "@evey/offline-audio": "workspace:*",
    "@evey/store": "workspace:*",
    "@evey/theme": "workspace:*",
    "@evey/voice-search": "workspace:*",
    "@expo/vector-icons": "15.1.1",
    "@tanstack/react-query": "5.102.6",
    "css-tree": "1.1.3",
    "expo": "55.0.23",
    "expo-audio": "^55.0.14",
    "expo-file-system": "55.0.19",
    "expo-image": "55.0.10",
    "expo-keep-awake": "55.0.8",
    "expo-localization": "55.0.13",
    "expo-router": "55.0.14",
    "expo-secure-store": "55.0.13",
    "expo-video": "55.0.16",
    "i18next": "26.4.0",
