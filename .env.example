# ── Required ──────────────────────────────────────────────────────────────────
EVEY_DB_PASSWORD=changeme
MEILI_MASTER_KEY=change-me-run-openssl-rand-hex-16
MEDIA_DIR=/path/to/your/media

# ── Server ────────────────────────────────────────────────────────────────────
EVEY_SERVER_BASE_URL=http://localhost:9091
EVEY_SERVER_NAME=Evey
EVEY_HTTP_PORT=9091
# EVEY_VERSION=latest

# ── Database ──────────────────────────────────────────────────────────────────
EVEY_DB_USER=evey
EVEY_DB_NAME=evey
EVEY_DB_SSLMODE=disable

# ── Metadata (recommended) ───────────────────────────────────────────────────
EVEY_TMDB_API_KEY=
EVEY_OMDB_API_KEY=
EVEY_METADATA_LANGUAGE=en

# ── Intro detection (optional) ───────────────────────────────────────────────
# TheIntroDB Bearer key — 500 lookups/day vs 100 anonymous. Toggle the
# providers from /admin/server-config (intro_providers.enabled). See
# docs/adr/0011-intro-detection-providers.md.
EVEY_INTRO_TIDB_API_KEY=
EVEY_INTRO_FFMPEG_THREADS=1

# ── Transcoding ──────────────────────────────────────────────────────────────
EVEY_TRANSCODING_MAX_CONCURRENT=2
EVEY_TRANSCODING_HW_ACCEL_ENABLED=false

# ── Libraries ────────────────────────────────────────────────────────────────
EVEY_LIBRARY_WATCHER_ENABLED=true

# ── Plugins: sandbox & limits ────────────────────────────────────────────────
# Full per-scenario guide: docs/plugins/sandbox-deployment.md
# Sandbox backend. auto = pick the strongest your host supports (recommended).
EVEY_PLUGINS_SANDBOX_MODE=auto          # auto | landlock | bubblewrap | strict | basic
# Run plugins under a separate user (UID 1001) so they can't read the server's
# secrets by file permissions. auto = on only on hosts without Landlock (where
# it's the only secret wall); on = always (extra layer); off = never.
# Incompatible with the no-new-privileges hardening option.
EVEY_PLUGINS_UID_SEPARATION=auto        # auto | on | off
# Per-plugin resource caps (also admin-editable at runtime from Admin → Plugins):
EVEY_PLUGINS_MEMORY_MB=256              # max RAM per plugin (MiB)
EVEY_PLUGINS_PIDS_MAX=64                # max processes/threads per plugin
EVEY_PLUGINS_DISK_MAX_MB=100            # max install-dir size per plugin (MiB; 0 = off)
EVEY_PLUGINS_CPU_NICE=10                # scheduling nice 0–19 (higher = lower priority)

# ── Playback ─────────────────────────────────────────────────────────────────
EVEY_PLAYBACK_MAX_STREAMS=0

# ── Email (optional — enables password recovery + notifications) ─────────────
# EVEY_SMTP_HOST=smtp.example.com
# EVEY_SMTP_PORT=587
# EVEY_SMTP_USERNAME=
# EVEY_SMTP_PASSWORD=
# EVEY_SMTP_FROM=noreply@example.com
# EVEY_SMTP_TLS=starttls

# ── SSO / OIDC (optional) ───────────────────────────────────────────────────
# EVEY_OIDC_ENABLED=false
# EVEY_OIDC_ISSUER=
# EVEY_OIDC_CLIENT_ID=
# EVEY_OIDC_CLIENT_SECRET=
# EVEY_OIDC_ALLOWED_EMAIL_DOMAINS=

# ── Backups (optional) ──────────────────────────────────────────────────────
# EVEY_BACKUP_INTERVAL_HOURS=0
# EVEY_BACKUP_RETENTION_DAYS=30

# ── Reverse proxy ───────────────────────────────────────────────────────────
# EVEY_TRUSTED_PROXIES=172.16.0.0/12
# EVEY_FORWARDED_PROTO=true
# EVEY_DOMAIN=media.example.com

# ── Logging ──────────────────────────────────────────────────────────────────
EVEY_LOG_LEVEL=info

# ── Hardware transcoding (optional) ──────────────────────────────────────────
# GID of the host's `render` group, for /dev/dri GPU passthrough (VAAPI).
# Find it with: getent group render
# Leave unset to use the default (104); wrong value = no GPU access, evey
# silently falls back to software transcode.
# EVEY_RENDER_GID=104
