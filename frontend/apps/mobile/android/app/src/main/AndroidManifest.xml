<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.CAMERA"/>
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
  <!-- Android 13+: without this the Cast SDK's media notification (a
       foreground service) cannot show, Android freezes the app ~60s after
       the screen turns off, and receivers that do not survive losing their
       sender (an operator box) cut the playback. The runtime
       request lives in lib/castNotificationPermission.ts. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <!-- Permission for the service declared below. Since targetSdk 34 a
       foreground service must announce its type AND hold the matching
       permission, otherwise Android refuses to start it. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
  <!-- Locks held during a Cast session by cast/CastKeepAlive.kt. A foreground
       service keeps the process from being FROZEN but does not hold the CPU:
       screen off, the CPU suspends, the CASTV2 heartbeat PONGs stop going out,
       the receiver closes the sender socket and tears the receiver down
       (measured in prod: the TV died 3 min 40 after the phone went silent).
       The partial wakelock is the load-bearing piece, it is what a widespread
       Android Cast client holds; the WifiLock is the extra belt. -->
  <uses-permission android:name="android.permission.WAKE_LOCK"/>
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" tools:replace="android:maxSdkVersion"/>
  <!-- The app never records audio (expo-camera is only used for QR barcode
       scanning, expo-audio only for playback) - but expo-audio and expo-camera
       each bundle RECORD_AUDIO unconditionally in their own module manifest,
       so a plain omission here would still be merged in. tools:node="remove"
       is required to actually strip it from the final APK. -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove"/>
  <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
  <uses-permission android:name="android.permission.USE_FINGERPRINT"/>
  <uses-permission android:name="android.permission.VIBRATE"/>
  <!-- Legacy (API<=32) scoped write, required by expo-file-system (download
       cache) and expo-image-picker (avatar upload); both bundle it themselves. -->
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" tools:replace="android:maxSdkVersion"/>
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <category android:name="android.intent.category.BROWSABLE"/>
      <data android:scheme="https"/>
    </intent>
  </queries>
  <application android:name=".MainApplication" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="true" android:theme="@style/AppTheme" android:supportsRtl="true" android:enableOnBackInvokedCallback="false" android:fullBackupContent="@xml/secure_store_backup_rules" android:dataExtractionRules="@xml/secure_store_data_extraction_rules" android:usesCleartextTraffic="true">
    <!-- Our OptionsProvider (Cast Connect): the package's one plus
         setAndroidReceiverCompatible(true), see cast/EveyCastOptionsProvider.kt.
         This manifest is maintained by hand (no prebuild), so the line is
         written here in addition to the withCastConnectSender plugin. -->
    <meta-data android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME" android:value="com.evey.app.cast.EveyCastOptionsProvider"/>
    <!-- Custom Evey Web Receiver (Cast Console D36A449B, https://cast.eveyproject.org):
         probes its capabilities on the TV and decodes AC-3 in wasm. While the app
         console is Unpublished, only registered test devices load it - publish
         before distributing this APK. -->
    <meta-data android:name="com.reactnative.googlecast.RECEIVER_APPLICATION_ID" android:value="D36A449B"/>
    <!-- The Cast SDK SHIPS the MediaNotificationService class but declares it
         in none of its AARs (play-services-cast-framework 22.3.1 only declares
         MediaIntentReceiver and ReconnectionService): the app has to. Without
         this line the service never starts, the Cast media notification does
         not exist, and nothing stops Android from freezing the app as soon as
         it leaves the foreground - the receiver then loses its sender and the
         box tears it down (measured in prod: ReportProgress died 21 s into the
         cast, resumed when the screen was woken 13 min later). This is the
         link POST_NOTIFICATIONS alone was missing. -->
    <service android:name="com.google.android.gms.cast.framework.media.MediaNotificationService" android:exported="false" android:foregroundServiceType="mediaPlayback"/>
    <!-- GoogleCastOptionsProvider (react-native-google-cast) calls
         setExpandedControllerActivityClassName() UNCONDITIONALLY, while the
         package's expo plugin only declares that activity when given
         expandedController: true. The SDK's media notification therefore
         targeted a component missing from the manifest. Declare it so the
         Cast stack is complete rather than half there. -->
    <activity android:name="com.reactnative.googlecast.RNGCExpandedControllerActivity" android:exported="false"/>
    <!-- play-services-code-scanner (pulled in by expo-camera for its
         launchScanner API, which this app never calls) declares its delegate
         activity portrait-only. Android 16 ignores that lock on large screens
         and Play flags it as a resize/orientation restriction, so lift it. -->
    <activity android:name="com.google.mlkit.vision.codescanner.internal.GmsBarcodeScanningDelegateActivity" android:screenOrientation="unspecified" tools:replace="android:screenOrientation"/>
