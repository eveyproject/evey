evey.test {
	tls internal

# Long-running: scan + transcode need no timeout + immediate flush
	@streaming {
		path /api/v1/media/*/transcode /api/v1/media/*/hls/* /api/v1/media/*/stream /api/v1/libraries/*/scan
	}
	handle @streaming {
		reverse_proxy evey:{$EVEY_HTTP_PORT:9091} {
			transport http {
				read_timeout 0
				write_timeout 0
			}
			flush_interval -1
		}
	}

	handle /api/* {
		reverse_proxy evey:{$EVEY_HTTP_PORT:9091} {
			flush_interval -1
		}
	}

	# The server's discovery probe. Every client (TV, phone) checks /healthz
	# before it signs in; left to the catch-all it got Vite's index.html and
	# said "not an Evey server" against the dev stack.
	handle /healthz {
		reverse_proxy evey:{$EVEY_HTTP_PORT:9091}
	}

	# WebSocket (Vite HMR): persistent, no keepalive restrictions
	@websocket {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @websocket {
		reverse_proxy web:{$WEB_PORT:5173} {
			transport http {
				versions 1.1
			}
		}
	}

	handle {
		reverse_proxy web:{$WEB_PORT:5173} {
			transport http {
				versions 1.1
				keepalive 3s
			}
		}
	}
}

# Liveness endpoint for the container healthcheck, on PLAIN HTTP.
#
# The site address carries an explicit http:// scheme, which is what stops Caddy
# from auto-redirecting it to HTTPS. That matters: this config only serves
# evey.test, with an internal cert, so a probe aimed at `localhost` used to get
# a 308 to HTTPS and then die in the TLS handshake - the healthcheck could never
# pass and had failed 6561 times in a row before this.
http://localhost {
	handle /healthz {
		respond "ok" 200
	}
	handle {
		respond 404
	}
}
