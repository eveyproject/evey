# Evey plugin runtimes - copy and customize as needed
# Usage: replace Dockerfile.dev reference in docker-compose.yml
#   build:
#     dockerfile: docker/Dockerfile.plugins.example
#
# Debian base (NOT Alpine): evey uses jellyfin-ffmpeg everywhere (tonemapx + HLS
# patches, parity with prod), and jellyfin-ffmpeg7 ships ONLY as a Debian package.

FROM golang:1.27.2-trixie

RUN apt-get update && apt-get -y upgrade && apt-get install -y --no-install-recommends \
    ca-certificates curl gnupg postgresql-client-17 libchromaprint-tools \
    # ── Default runtimes (always included) ──
    python3 python3-pip python3-grpcio python3-protobuf \
    nodejs npm \
    && ([ -e /usr/bin/node ] || ln -sf /usr/bin/nodejs /usr/bin/node) \
    && go install github.com/air-verse/air@latest \
    && npm install -g esbuild@0.25.12

# jellyfin-ffmpeg7 - the ONLY ffmpeg (tonemapx HDR filter + HLS/muxer patches;
# parity with the prod runtime). Installed from the Jellyfin project's official
# Debian repo, symlinked onto PATH. No Debian/vanilla ffmpeg is installed.
RUN install -d /etc/apt/keyrings \
    && curl -fsSL https://repo.jellyfin.org/jellyfin_team.gpg.key \
         | gpg --dearmor -o /etc/apt/keyrings/jellyfin.gpg \
    && printf 'Types: deb\nURIs: https://repo.jellyfin.org/debian\nSuites: trixie\nComponents: main\nSigned-By: /etc/apt/keyrings/jellyfin.gpg\n' \
         > /etc/apt/sources.list.d/jellyfin.sources \
    && apt-get update && apt-get install -y --no-install-recommends jellyfin-ffmpeg7 \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/lib/jellyfin-ffmpeg/ffmpeg  /usr/local/bin/ffmpeg \
    && ln -sf /usr/lib/jellyfin-ffmpeg/ffprobe /usr/local/bin/ffprobe

# ── Uncomment the runtimes you need for your plugins (Debian / apt) ──

# PHP
# RUN apt-get update && apt-get install -y --no-install-recommends php-cli php-grpc php-protobuf composer

# Ruby
# RUN apt-get update && apt-get install -y --no-install-recommends ruby ruby-dev build-essential \
#     && gem install grpc google-protobuf

# Java/Kotlin (JRE only - plugins ship compiled .jar)
# RUN apt-get update && apt-get install -y --no-install-recommends openjdk-17-jre-headless

# Dart
# RUN apt-get update && apt-get install -y --no-install-recommends dart

# Elixir
# RUN apt-get update && apt-get install -y --no-install-recommends elixir

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

ENV EVEY_LOG_DEV_MODE=true

CMD ["air", "-c", ".air.toml"]
