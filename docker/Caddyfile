{$EVEY_DOMAIN:localhost} {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		X-XSS-Protection "1; mode=block"
		Content-Security-Policy "default-src 'self'; img-src 'self' https://image.tmdb.org data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'"
	}

	handle /api/* {
		reverse_proxy evey-prod:9091
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
