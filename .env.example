# Database
EVEY_DB_HOST=localhost
EVEY_DB_PORT=5432
EVEY_DB_USER=evey
EVEY_DB_PASSWORD=changeme
EVEY_DB_NAME=evey
EVEY_DB_SSLMODE=disable

# Server
# gRPC listens on EVEY_SERVER_PORT; HTTP gateway listens on EVEY_SERVER_PORT+1
EVEY_SERVER_PORT=9090
EVEY_SERVER_BASE_URL=http://localhost:9091
EVEY_SERVER_NAME=Evey

# JWT
EVEY_JWT_PRIVATE_KEY_PATH=/data/keys/jwt.pem
EVEY_JWT_ACCESS_TTL=15m
EVEY_JWT_REFRESH_TTL=168h

# Meilisearch
EVEY_MEILI_URL=http://localhost:7700
EVEY_MEILI_API_KEY=changeme
MEILI_MASTER_KEY=changeme

# TMDB
EVEY_TMDB_API_KEY=

# Metadata
EVEY_METADATA_LANGUAGE=en

# Transcoding
EVEY_TRANSCODING_CACHE_DIR=/data/transcoding
EVEY_TRANSCODING_MAX_CONCURRENT=2
EVEY_TRANSCODING_CACHE_MAX_GB=50
EVEY_TRANSCODING_HW_ACCEL_ENABLED=false

# Library
EVEY_LIBRARY_SCAN_INTERVAL=6h
EVEY_LIBRARY_WATCHER_ENABLED=true

# Playback
EVEY_PLAYBACK_MAX_STREAMS=0

# OIDC (optional)
EVEY_OIDC_ENABLED=false
EVEY_OIDC_ISSUER=
EVEY_OIDC_CLIENT_ID=
EVEY_OIDC_CLIENT_SECRET=

# Metrics
EVEY_METRICS_RETENTION_DAYS=90
EVEY_METRICS_SAMPLE_INTERVAL_SEC=60

# Logging
EVEY_LOG_LEVEL=info
EVEY_LOG_DIR=/data/logs
EVEY_LOG_MAX_SIZE_MB=50
EVEY_LOG_RETENTION_DAYS=7
EVEY_LOG_DEV_MODE=false
EVEY_PLUGIN_DEBUG=false
