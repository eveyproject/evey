{
  "title": "Evey Server",
  "uid": "evey-main",
  "schemaVersion": 38,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP Requests/sec",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum(rate(evey_http_requests_total[5m])) by (method, status)",
          "legendFormat": "{{method}} {{status}}"
        }
      ],
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP p99 Latency",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(evey_http_request_duration_seconds_bucket[5m])) by (le, path))",
          "legendFormat": "p99 {{path}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active HLS Sessions",
      "gridPos": {"x": 0, "y": 8, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "evey_hls_sessions",
          "legendFormat": "HLS Sessions"
        }
      ],
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active Transcodes",
      "gridPos": {"x": 6, "y": 8, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "evey_transcodes_active",
          "legendFormat": "Transcodes"
        }
      ],
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "DB Connections Open",
      "gridPos": {"x": 12, "y": 8, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "evey_db_connections_open",
          "legendFormat": "Open"
        }
      ],
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Go Goroutines",
      "gridPos": {"x": 18, "y": 8, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "go_goroutines",
          "legendFormat": "Goroutines"
        }
      ],
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {"text": "Prometheus", "value": "Prometheus"}
      }
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "refresh": "30s"
}
