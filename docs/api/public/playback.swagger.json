        },
        "value": {
          "type": "number",
          "format": "double"
        },
        "maxValue": {
          "type": "number",
          "format": "double",
          "title": "10 for imdb/tmdb, 100 for rt/metacritic"
        }
      }
    },
    "v1ReportProgressRequest": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string"
        },
        "positionMs": {
          "type": "string",
          "format": "int64"
        },
        "isPaused": {
          "type": "boolean"
        },
        "isMuted": {
          "type": "boolean"
        },
        "volumeLevel": {
          "type": "integer",
          "format": "int32"
        },
        "castDeviceName": {
          "type": "string",
          "description": "Name of the remote device the media is ACTUALLY playing on when the\nreporting client is only a relay (web sender driving a Chromecast).\nThe position/pause fields above then describe the REMOTE playback.\nEmpty = playing on the session's own device (clears a previous value)."
        }
      }
    },
    "v1ReportProgressResponse": {
      "type": "object",
      "properties": {
        "remoteCommand": {
          "type": "string"
        }
      }
    },
    "v1StartStreamRequest": {
      "type": "object",
      "properties": {
        "mediaItemId": {
          "type": "string"
        },
        "profileId": {
          "type": "string"
        },
        "playMethod": {
          "$ref": "#/definitions/v1PlayMethod"
        },
        "deviceId": {
          "type": "string"
        },
        "deviceName": {
          "type": "string"
        },
        "clientName": {
          "type": "string"
        },
        "startPositionMs": {
          "type": "string",
          "format": "int64"
        },
        "audioStreamIndex": {
          "type": "integer",
          "format": "int32"
        },
        "subtitleStreamIndex": {
          "type": "integer",
          "format": "int32"
        },
        "servedBitrateBps": {
          "type": "string",
          "format": "int64",
          "description": "Bitrate (bits/s) the client will actually pull, copied from the StreamInfo\nthe player just fetched. Stamped onto the session so the admin dashboard\nshows the served rate, not the source. Absent/0 falls back to the source\nbitrate server-side (older clients keep the previous behaviour)."
        },
        "videoDecision": {
          "type": "string",
          "description": "Per-track serving decision + served codecs/resolution, copied from the\nStreamInfo the player just resolved. Persisted on the session so the admin\npanel can distinguish a copy rung (video copied) from a real transcode and\nshow the served codecs. video_decision/audio_decision are \"copy\"|\"transcode\";\nvideo_codec/audio_codec carry a \"source-\u003etarget\" form when transcoding."
        },
        "audioDecision": {
          "type": "string"
        },
        "videoCodec": {
          "type": "string"
        },
        "audioCodec": {
          "type": "string"
        },
        "resolution": {
          "type": "string"
        }
      }
    },
    "v1StopStreamRequest": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string"
        },
        "positionMs": {
          "type": "string",
          "format": "int64"
        }
      }
    },
    "v1StopStreamResponse": {
      "type": "object"
    },
    "v1StreamInfo": {
      "type": "object",
      "properties": {
        "mediaItemId": {
          "type": "string"
        },
        "directPlayUrl": {
          "type": "string"
        },
        "transcodeUrl": {
          "type": "string"
        },
        "mediaStreams": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1MediaStream"
          }
        },
        "playMethod": {
          "$ref": "#/definitions/v1PlayMethod"
        },
        "container": {
          "type": "string"
        },
        "bitrate": {
          "type": "string",
          "format": "int64"
        },
        "transcodeReasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "videoDecision": {
          "type": "string"
        },
        "audioDecision": {
          "type": "string"
        },
        "videoCodec": {
          "type": "string",
          "description": "Target (served) codecs and resolution the client will actually receive.\nFor a copy decision these equal the source; for a transcode they are the\nrung output (e.g. h264 / aac). The player echoes them back on StartStream\nso the admin \"Now Playing\" panel can show what's really being served."
        },
        "audioCodec": {
          "type": "string"
        },
        "resolution": {
          "type": "string"
        },
        "audioBitrate": {
          "type": "string",
          "format": "int64",
          "description": "Audio bitrate actually served, in bits per second. A Matroska container\nrarely carries a per-track bitrate, so the source probe usually has none -\nbut on a transcode we know it exactly: it is what we ask the encoder for.\n0 when unknown (audio copied from a source that declares no bitrate)."
        }
      }
    },
    "v1Trailer": {
      "type": "object",
      "properties": {
        "site": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "official": {
          "type": "boolean"
        },
        "type": {
          "type": "string"
        },
        "useSubtitles": {
          "type": "boolean"
        },
        "subtitleLanguage": {
          "type": "string"
        }
      }
    },
    "v1WatchProgress": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "profileId": {
          "type": "string"
        },
        "mediaItemId": {
          "type": "string"
        },
        "positionMs": {
          "type": "string",
          "format": "int64"
        },
        "durationMs": {
          "type": "string",
          "format": "int64"
        },
        "percentComplete": {
          "type": "number",
          "format": "double"
        },
        "played": {
          "type": "boolean"
        },
        "playCount": {
          "type": "integer",
          "format": "int32"
        },
        "lastPlayedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "title": {
          "type": "string",
          "description": "Display metadata, populated by GetWatchHistory so clients show a real label\ninstead of the bare media_item_id. Empty when the item can't be resolved.\n\nmovie title, or episode title for episodes"
        },
        "mediaType": {
          "type": "string",
          "description": "\"movie\" | \"episode\" | \"track\" | ..."
        },
        "indexNumber": {
          "type": "integer",
          "format": "int32",
          "title": "episode number (episodes only)"
        },
        "parentIndexNumber": {
          "type": "integer",
          "format": "int32",
          "title": "season number (episodes only)"
        },
        "seriesTitle": {
          "type": "string",
          "title": "parent series title (episodes only)"
        }
      }
    }
  }
