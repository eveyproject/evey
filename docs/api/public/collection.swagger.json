  "paths": {
    "/api/v1/collections": {
      "get": {
        "operationId": "CollectionService_ListCollections",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListCollectionsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "minItems",
            "description": "Collections holding fewer than this many VISIBLE members are omitted.\n0 means the server default (2): a saga you own one film of is a film, not\na collection, and 97% of the auto-created TMDB sagas were exactly that -\na wall of one-title entries nobody could use (measured 2026-08-04).\nPass 1 to list everything, which is what curation screens want.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "CollectionService"
        ]
      },
      "post": {
        "operationId": "CollectionService_CreateCollection",
        "responses": {
          "200": {
            "description": "A successful response.",
