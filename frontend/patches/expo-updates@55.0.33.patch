diff --git a/android/src/main/java/expo/modules/updates/EveyReleaseFloor.kt b/android/src/main/java/expo/modules/updates/EveyReleaseFloor.kt
new file mode 100644
index 0000000..10ad77f
--- /dev/null
+++ b/android/src/main/java/expo/modules/updates/EveyReleaseFloor.kt
@@ -0,0 +1,87 @@
+package expo.modules.updates
+
+import android.content.Context
+import expo.modules.updates.db.entity.UpdateEntity
+import expo.modules.updates.db.enums.UpdateStatus
+import expo.modules.updates.manifest.EmbeddedManifestUtils
+import java.util.Date
+
+/**
+ * Evey: the oldest release this device still accepts from a server.
+ *
+ * A signature proves an update was published by the project, not that it is
+ * recent: without a floor, any server could hand out an old signed release and
+ * bring back a bug that was fixed since. The floor is the newer of the release
+ * the app was built from and the newest served release that rendered here, and
+ * it only goes up. The code built into the app is not subject to it.
+ *
+ * Values are the release time in milliseconds, the manifest's signed
+ * `createdAt`. An app whose floor cannot be read accepts nothing.
+ */
+object EveyReleaseFloor {
+  private const val PREFS_FILE = "evey.client-updates"
+  private const val PREFS_KEY = "floor"
+  private const val BUILT_FROM_RESOURCE = "evey_client_update_floor"
+
+  @Volatile
+  private var appContext: Context? = null
+
+  fun init(context: Context) {
+    appContext = context.applicationContext
+  }
+
+  /** The release time of the commit this app was built from, as recorded by the build. */
+  fun builtFrom(context: Context): Long? {
+    val resource = context.resources.getIdentifier(BUILT_FROM_RESOURCE, "string", context.packageName)
+    if (resource == 0) {
+      return null
+    }
+    return context.getString(resource).toLongOrNull()
+  }
+
+  @Synchronized
+  fun current(): Long {
+    val context = appContext ?: return Long.MAX_VALUE
+    val builtFrom = builtFrom(context) ?: return Long.MAX_VALUE
+    val reached = context.getSharedPreferences(PREFS_FILE, Context.MODE_PRIVATE).getLong(PREFS_KEY, 0L)
+    return maxOf(builtFrom, reached)
+  }
+
+  fun admits(update: UpdateEntity): Boolean = update.commitTime.time >= current()
+
+  fun admitsForLaunch(update: UpdateEntity): Boolean =
+    isBuiltIn(update) || (admits(update) && !isLeftBehind(update))
+
+  /**
+   * The code built into another build of the same commit, still stored after
+   * this build replaced it. It has the date of this build's own code and
+   * would be started in its place, without the files it needs. No served
+   * release is dated to the exact second.
+   */
+  private fun isLeftBehind(update: UpdateEntity): Boolean {
+    val context = appContext ?: return false
+    return update.commitTime.time == builtFrom(context)
+  }
+
+  private fun isBuiltIn(update: UpdateEntity): Boolean =
+    update.status == UpdateStatus.EMBEDDED || EmbeddedManifestUtils.isBuiltIn(update)
+
+  /** Called once a served update has rendered. */
+  @Synchronized
+  fun raiseTo(update: UpdateEntity) {
+    val context = appContext ?: return
+    if (isBuiltIn(update)) {
+      return
+    }
+    val prefs = context.getSharedPreferences(PREFS_FILE, Context.MODE_PRIVATE)
+    if (update.commitTime.time > prefs.getLong(PREFS_KEY, 0L)) {
+      prefs.edit().putLong(PREFS_KEY, update.commitTime.time).commit()
+    }
+  }
+
+  /**
+   * The time certificates are checked against. A device clock can be set
+   * back; the floor is a time this device is known to have passed.
+   */
+  fun certificateCheckTime(): Date = Date(maxOf(System.currentTimeMillis(), current()))
+}
