  "definitions": {
    "CollectionServiceAddCollectionItemBody": {
      "type": "object",
      "properties": {
        "mediaItemId": {
          "type": "string"
        },
        "sortOrder": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "CollectionServiceReorderCollectionItemsBody": {
      "type": "object",
      "properties": {
        "mediaItemIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The members in their new order. Position in this list IS the new\nposition; any member left out keeps its current one."
        }
      }
    },
    "CollectionServiceUpdateCollectionBody": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1CollectionRule"
          }
        },
        "sortBy": {
          "type": "string"
        },
        "smart": {
          "type": "boolean"
        },
        "overview": {
          "type": "string",
          "description": "Optional so that a client editing only the name leaves the synopsis of a\nTMDB saga alone: absent means \"keep\", empty string means \"clear\"."
        }
      }
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1AddCollectionItemResponse": {
      "type": "object"
    },
    "v1CollectionItemProto": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "year": {
          "type": "integer",
          "format": "int32"
        },
        "overview": {
          "type": "string"
        },
        "communityRating": {
          "type": "number",
          "format": "double"
        },
        "genres": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "v1CollectionProto": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "overview": {
          "type": "string"
        },
        "tmdbId": {
          "type": "integer",
          "format": "int32"
        },
        "posterUrl": {
          "type": "string"
        },
        "backdropUrl": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1CollectionRule"
          }
        },
        "sortBy": {
          "type": "string",
          "description": "How the members are ordered. \"release\" (default) reads a saga in release\norder; \"manual\" honours the hand-set position, which is the only way to\nexpress a chronological order that differs from it (prequels).\nAlso \"title\", \"added_at\", \"year\", \"rating\"."
        },
        "sortOrder": {
          "type": "string"
        },
        "itemCount": {
          "type": "integer",
          "format": "int32",
          "description": "Number of members THIS caller can see - already access- and parental-\nfiltered. A client cannot compute it (it never receives the members of\nevery collection) and every surface needs it: to say \"4 films\", and to\ntell a real saga from a one-title stub."
        },
        "kind": {
          "type": "string",
          "description": "\"saga\" (sourced from a TMDB collection), \"smart\" (rule-driven) or\n\"manual\" (hand-built). Lets a client badge them and filter, instead of\ninferring it from the presence of tmdb_id."
        }
      }
    },
    "v1CollectionRule": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string"
        },
        "operator": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "v1CreateCollectionRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1CollectionRule"
          }
        },
        "sortBy": {
          "type": "string"
        },
        "smart": {
          "type": "boolean"
        },
        "overview": {
          "type": "string",
          "description": "Free text shown under the title, like the synopsis a TMDB saga carries.\nThe column and the domain always had it; only the request did not, so a\ndescription typed at creation went nowhere (found 2026-08-04)."
        }
      }
    },
    "v1CreateCollectionResponse": {
      "type": "object",
      "properties": {
        "collection": {
          "$ref": "#/definitions/v1CollectionProto"
        }
      }
    },
    "v1DeleteCollectionResponse": {
