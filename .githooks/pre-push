#!/usr/bin/env bash
# Pre-push hook - runs the CI gate locally before letting `git push` proceed,
# so a regression never reaches GitHub Actions and tanks the pipeline. A push
# to master runs `make pre-push` (the full mirror of CI); a push to dev or to
# a work branch runs `make pre-push-dev` (the same minus the long suites the
# pull request's CI reruns on those commits anyway).
#
# Activation (run once, per clone):
#     make hooks            # sets core.hooksPath to .githooks
#
# Bypass (when you know what you're doing - e.g. pushing docs-only):
#     git push --no-verify
#
# Heavy race tests (unit + postgres testcontainers) are NOT in this gate -
# they are the separate `correctness` CI job. Run them before a substantial
# push with:
#     make ci-local
#
# All checks run inside the evey-server container (Go pinned + module cache
# mounted), so they don't depend on a host Go install.

set -e

# The gate runs on the working tree, the push sends commits. With a tracked file
# modified or staged, what was tested is not what leaves: a commit red on its own
# passed here once because the fix sat uncommitted beside it. Untracked files are
# allowed (scratch output, local notes); ci-clean-checkout covers HEAD pointing
# at one of them.
dirty=$(git status --porcelain --untracked-files=no)
if [ -n "$dirty" ]; then
    echo "pre-push: tracked files differ from HEAD - the gate would test something other than what is pushed:" >&2
    echo "$dirty" | sed 's/^/           /' >&2
    echo "         commit them, or move them out of the way, then push again." >&2
    exit 1
fi

if ! command -v docker >/dev/null 2>&1; then
    echo "pre-push: docker not found on PATH - start the dev stack first or bypass with --no-verify." >&2
    exit 1
fi

if ! docker inspect --format '{{.State.Status}}' evey-server >/dev/null 2>&1; then
    echo "pre-push: container 'evey-server' is not running." >&2
    echo "         start it with 'make dev', or bypass with 'git push --no-verify'." >&2
    exit 1
fi

# The destination picks the gate. master and tags get the full mirror of CI;
# dev and work branches get pre-push-dev, which leaves out what the pull
# request's CI reruns on the exact same commits (the long suites). dev only
# merges on a green "CI passed", so nothing is skipped on the way in - it runs
# once instead of twice. GATE=full forces the full run on any push.
#
# A green `make gate` receipt for exactly this HEAD and this tree is the same
# run already done. It is bound to HEAD, so it only stands in when what is
# pushed IS HEAD (git hands the refs on stdin); any other ref gets the run.
target=pre-push-dev
pushed_is_head=1
head_sha=$(git rev-parse HEAD)
while read -r _local_ref local_sha remote_ref _remote_sha; do
    [ -z "$local_sha" ] && continue
    [ "$local_sha" = "$head_sha" ] || pushed_is_head=0
    case "$remote_ref" in
        refs/heads/master|refs/tags/*) target=pre-push ;;
    esac
done
[ "${GATE:-}" = "full" ] && target=pre-push
if [ "$pushed_is_head" = 1 ]; then
    for label in pre-push "$target"; do
        if python3 scripts/gate-receipt.py --label "$label" status >/dev/null 2>&1; then
            echo "pre-push: $label receipt is green for this exact HEAD and tree - not re-running it (make gate-status to see it)"
            exit 0
        fi
    done
fi

echo "pre-push: running make $target - bypass with 'git push --no-verify'"
exec make "$target"
