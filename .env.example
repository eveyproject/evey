# Evey configuration.
#
# This file holds only what must exist BEFORE the server boots: secrets,
# container wiring (ports, paths, image tag) and reverse-proxy facts.
#
# Everything an operator tunes afterwards - log level, language, transcoding
# limits, hardware acceleration, library watcher, plugin sandbox & quotas -
# lives in the admin panel (Admin → Server config), NOT here. Those settings
# are stored in the database, survive a container recreate, and most apply
# without a restart. Setting them as env vars only seeds a first boot.

# ── Required ──────────────────────────────────────────────────────────────────
EVEY_DB_PASSWORD=changeme
MEILI_MASTER_KEY=change-me-run-openssl-rand-hex-16
MEDIA_DIR=/path/to/your/media

# ── Server ────────────────────────────────────────────────────────────────────
# Public URL: used for e-mail links, OIDC redirects and cast/device URLs.
EVEY_SERVER_BASE_URL=http://localhost:9091
EVEY_HTTP_PORT=9091
# EVEY_SERVER_NAME=Evey
# EVEY_VERSION=latest

# ── Database ──────────────────────────────────────────────────────────────────
EVEY_DB_USER=evey
EVEY_DB_NAME=evey
# 'disable' is correct for the bundled Postgres on a private Docker network
# (the default 'prefer' negotiates TLS pointlessly and logs a warning).
EVEY_DB_SSLMODE=disable

# ── Metadata & intro providers - FIRST-BOOT SEED ONLY ────────────────────────
# These keys are read once, copied into the database, and from then on the
# admin panel is the source of truth (Admin → Server config → API keys).
# You can delete them from this file after the first successful boot.
# TheIntroDB is optional: a Bearer key raises 100 → 500 lookups/day.
EVEY_TMDB_API_KEY=
EVEY_OMDB_API_KEY=
EVEY_INTRO_TIDB_API_KEY=

# ── Reverse proxy ─────────────────────────────────────────────────────────────
# EVEY_DOMAIN feeds every bundled proxy example (Caddy, Nginx, Traefik).
# Set the other two whenever a proxy terminates TLS in front of Evey, or
# client IPs (rate limiting, logs) and generated links will be wrong.
# See docs/reverse-proxy.md - it also lists the CSP tokens a curating proxy
# must keep ('wasm-unsafe-eval', gstatic) for browser AC-3 and Chromecast.
# EVEY_DOMAIN=media.example.com
# EVEY_TRUSTED_PROXIES=172.16.0.0/12
# EVEY_FORWARDED_PROTO=true

# ── Hardware transcoding (optional) ──────────────────────────────────────────
# GID of the host's `render` group, for /dev/dri GPU passthrough (VAAPI).
# Find it with: getent group render
# Leave unset to use the default (104); a wrong value = no GPU access and
# Evey silently falls back to software transcode. Enable the acceleration
# itself from the admin panel, not here.
# EVEY_RENDER_GID=104

# ── Email (optional - enables password recovery + notifications) ─────────────
# EVEY_SMTP_HOST=smtp.example.com
# EVEY_SMTP_PORT=587
# EVEY_SMTP_USERNAME=
# EVEY_SMTP_PASSWORD=
# EVEY_SMTP_FROM=noreply@example.com
# EVEY_SMTP_TLS=starttls

# ── SSO / OIDC (optional) ───────────────────────────────────────────────────
# EVEY_OIDC_ENABLED=false
# EVEY_OIDC_ISSUER=
# EVEY_OIDC_CLIENT_ID=
# EVEY_OIDC_CLIENT_SECRET=
# EVEY_OIDC_ALLOWED_EMAIL_DOMAINS=

# ── Backups (optional) ──────────────────────────────────────────────────────
# EVEY_BACKUP_INTERVAL_HOURS=0
# EVEY_BACKUP_RETENTION_DAYS=30
