# Bundled reverse proxy. The site address is injected from the environment:
# set EVEY_DOMAIN in your .env (compose passes it through) and Caddy obtains
# a Let's Encrypt certificate for it automatically. Default: localhost.
{$EVEY_DOMAIN:localhost} {
	encode gzip

	header {
		# Deferred: these REPLACE the app's own copies instead of being added
		# next to them (the app sets the same headers; two HSTS with two
		# max-ages reached the browser on the demo, 2026-10-02).
		defer
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# The canonical Evey CSP for a curating proxy - keep in sync with
		# docs/reverse-proxy.md (Security headers & CSP). Load-bearing tokens:
		#   frame-src 'self'          plugin UIs and theme scripts, run in
		#                             /plugin-frame.html (its own policy, kept below)
		#   'wasm-unsafe-eval'        browser AC-3/E-AC-3 decoder (Wasm compile only)
		#   https://www.gstatic.com   Google Cast sender SDK (script + frame)
		#   media-src blob:           MSE playback (hls.js)
		#   worker-src blob:          hls.js demux worker
		# base-uri 'self' and object-src 'none' have NO fallback to default-src, so
		# they must be stated explicitly (matches securityHeadersMiddleware in
		# helpers.go): without them <base href> injection and <object>/<embed>
		# embedding stay unrestricted even though default-src is 'self'. This proxy
		# strips the app's own CSP (header_down below), so any hardening added there
		# must be mirrored in the policy below or it never reaches the browser.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	# Two pages carry their own policy, sent by the app and kept by this proxy:
	# the Chromecast receiver (Cast styles and fonts from gstatic, https media)
	# and the plugin frame (sandboxed, framed by the app only - so no
	# X-Frame-Options: DENY on it either).
	@ownPolicy path /cast-receiver.html /plugin-frame.html
	@appPolicy not path /cast-receiver.html /plugin-frame.html
	header @appPolicy {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self' https: data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval' https://www.gstatic.com; connect-src 'self' https: wss:; worker-src 'self' blob:; font-src 'self' data:; frame-src 'self' https://www.gstatic.com"
	}
	@notFrame not path /plugin-frame.html
	header @notFrame {
		defer
		X-Frame-Options DENY
	}

	# Streaming endpoints need no timeout
	@streaming {
		path /api/v1/media/*/transcode /api/v1/media/*/hls/* /api/v1/media/*/stream /api/v1/libraries/*/scan
	}
	handle @streaming {
		reverse_proxy evey:9091 {
			transport http {
				read_timeout 0
				write_timeout 0
			}
			flush_interval -1
			# Exactly ONE CSP must reach the browser (two = the browser
			# enforces the intersection, silently). This proxy curates the
			# policy above, so the app's own header is stripped.
			header_down -Content-Security-Policy
		}
	}

	handle @ownPolicy {
		reverse_proxy evey:9091
	}

	# Everything else goes to the backend (which serves both API and frontend)
	handle {
		reverse_proxy evey:9091 {
			flush_interval -1
			header_down -Content-Security-Policy
		}
	}
}
