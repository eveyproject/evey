.git
*.md
data/
logs/
# Local docker-compose volume mounts (root-owned, gitignored): never part of
# the build context - they pollute it and break the build on permission-denied.
caddy-config/
caddy-data/
evey-data/
meili-data/
postgres-data/
tmp/
**/*.pem
.env
**/node_modules
**/.expo
**/dist

# Client bundles: only what make client-updates signs reaches the build, where
# the Dockerfile checks its commit and runtime. Unsigned leftovers do not.
client-updates/**
!client-updates/.gitkeep
!client-updates/*/*/*/manifest.signed
!client-updates/*/*/*/commit
!client-updates/*/*/*/assets/**
