# Compose — set to "dev" or "prod"
COMPOSE_PROFILES=dev

# Ports (EVEY_HTTP_PORT = EVEY_SERVER_PORT+1, used by compose only)
EVEY_SERVER_PORT=9090
EVEY_HTTP_PORT=9091
WEB_PORT=5173
POSTGRES_PORT=5432
MEILI_PORT=7700

# Database
POSTGRES_DATA_DIR=~/.evey/postgres-data
EVEY_DB_USER=evey
EVEY_DB_PASSWORD=changeme
EVEY_DB_NAME=evey
EVEY_DB_SSLMODE=disable
EVEY_DB_MAX_OPEN_CONNS=50
EVEY_DB_MAX_IDLE_CONNS=10

# Meilisearch (shared by Meilisearch container and Evey server)
MEILI_MASTER_KEY=change-me-generate-a-random-secret

# Server
EVEY_SERVER_BASE_URL=http://localhost:9091
EVEY_SERVER_NAME=Evey

# Rate limiting (logins/min per IP; set higher for E2E)
EVEY_RATELIMIT_LOGIN_MAX=10

# JWT
EVEY_JWT_ACCESS_TTL=15m
EVEY_JWT_REFRESH_TTL=168h

# TMDB
EVEY_TMDB_API_KEY=

# OMDb (https://www.omdbapi.com/apikey.aspx)
EVEY_OMDB_API_KEY=

# Metadata
EVEY_METADATA_LANGUAGE=en

# Transcoding
EVEY_TRANSCODING_MAX_CONCURRENT=2
EVEY_TRANSCODING_CACHE_MAX_GB=50
EVEY_TRANSCODING_HW_ACCEL_ENABLED=false

# Library
EVEY_LIBRARY_SCAN_INTERVAL=6h
EVEY_LIBRARY_WATCHER_ENABLED=true
EVEY_LIBRARY_PERIODIC_SCAN_INTERVAL=2m  # fallback for libraries where inotify fails

# Playback
EVEY_PLAYBACK_MAX_STREAMS=0

# OIDC (optional)
EVEY_OIDC_ENABLED=false
EVEY_OIDC_ISSUER=
EVEY_OIDC_CLIENT_ID=
EVEY_OIDC_CLIENT_SECRET=
EVEY_OIDC_ALLOWED_EMAIL_DOMAINS=  # comma-separated, e.g. example.com,company.org; empty = allow all

# Metrics
EVEY_METRICS_RETENTION_DAYS=90
EVEY_METRICS_SAMPLE_INTERVAL_SEC=60

# Logging
EVEY_LOG_LEVEL=info
EVEY_LOG_DIR=/data/logs
EVEY_LOG_MAX_SIZE_MB=50
EVEY_LOG_RETENTION_DAYS=90
EVEY_LOG_PLUGIN_RETENTION_DAYS=10
EVEY_LOG_DEV_MODE=false
EVEY_PLUGIN_DEBUG=false

# OpenSubtitles (optional — https://www.opensubtitles.com/en/consumers)
EVEY_OPENSUBTITLES_API_KEY=
EVEY_OPENSUBTITLES_USERNAME=
EVEY_OPENSUBTITLES_PASSWORD=

# FCM Push Notifications (optional)
FCM_ENABLED=false
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=

# Backup
EVEY_BACKUP_DIR=/data/backups
EVEY_BACKUP_INTERVAL_HOURS=0
EVEY_BACKUP_RETENTION_DAYS=30

# Prod only — media dir mounted as /media in container
MEDIA_DIR=/path/to/your/media
# Prod only — domain for Caddy HTTPS (if using bundled Caddy)
EVEY_DOMAIN=localhost

# Docker Hub — used by docker-compose.yml to pull the image
DOCKERHUB_USERNAME=your-dockerhub-username
EVEY_VERSION=latest
