{
  "expo": {
    "name": "Evey TV",
    "slug": "evey-tv",
    "version": "0.0.1-beta.7",
    "scheme": "evey",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "platforms": ["ios", "android"],
    "ios": {
      "bundleIdentifier": "com.evey.tv",
      "isAppleTVOnly": true
    },
    "android": {
      "package": "com.evey.tv",
      "versionCode": 8,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      }
    },
    "plugins": [
      "./plugins/withCleartextTraffic",
      "./plugins/withReleaseSigning",
      "expo-router",
      "expo-video",
      ["@react-native-tvos/config-tv", { "isTV": true, "androidTVBanner": "./assets/tv_banner.png" }]
    ]
  }
}
