{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/dist/**",
    "**/dist-*/**",
    "**/.expo/**",
    "**/android/**",
    "**/ios/**",
    "apps/web/public/wasm/**"
  ],
  "overrides": [
    {
      "files": [
        "packages/client/src/web/PluginIframe.tsx",
        "apps/web/src/features/themes/ThemeLoader.tsx",
        "apps/mobile/src/features/plugins/PluginSlot.tsx",
        "apps/tv/src/features/plugins/PluginSlot.tsx"
      ],
      "rules": {
        "no-useless-escape": "off"
      }
    }
  ]
}
