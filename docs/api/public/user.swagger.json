  "definitions": {
    "UserServiceCreateProfileBody": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "avatarPath": {
          "type": "string"
        },
        "preferences": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "maxRating": {
          "type": "string"
        },
        "isKids": {
          "type": "boolean"
        },
        "pin": {
          "type": "string",
          "title": "4-digit PIN required when kids profile exists"
        },
        "locale": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "maxAge": {
          "type": "integer",
          "format": "int32",
          "description": "Parental age cap. Only honored when is_kids=true; ignored otherwise.\nUnset = fall back to the implicit kids default (12)."
        }
      }
    },
    "UserServiceImpersonateUserBody": {
      "type": "object",
      "properties": {
        "profileId": {
          "type": "string",
          "description": "Optional: which of the target's profiles to activate. Empty = the target's\ndefault profile. Must belong to user_id or the request is rejected."
        }
      }
    },
    "UserServiceSetDefaultProfileBody": {
      "type": "object"
    },
    "UserServiceUpdateProfileBody": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "avatarPath": {
          "type": "string"
        },
        "preferences": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "maxRating": {
          "type": "string"
        },
        "maxBitrateKbps": {
          "type": "integer",
          "format": "int32"
        },
        "locale": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "isKids": {
          "type": "boolean"
        },
        "pin": {
          "type": "string",
          "title": "empty string clears the PIN; 4 digits sets it"
        },
        "maxAge": {
