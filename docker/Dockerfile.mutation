# Mutation testing (gremlins), isolated from the working tree.
#
# gremlins walks the module root and, on this repo, that root also holds the
# bind-mounted Docker volumes (postgres-data/, caddy-data/, evey-data/). They are
# owned by root with restrictive modes, so the walk died on permission denied
# before any mutation ran - and gremlins 0.5.0 has no --exclude to skip them.
#
# The fix is not to run as root, it is to run somewhere those directories do not
# exist. The image takes a CLEAN checkout (git archive, which honours .gitignore,
# so the volumes are absent by construction) and runs as a normal user.
#
# It also never runs on the host: mutation testing recompiles and re-runs a
# package's tests once per mutant, which is exactly the workload that wedges WSL.
# In a container it can be given explicit CPU limits.
FROM golang:1.27.0-alpine

RUN apk add --no-cache gcc musl-dev linux-headers git bash

# Pinned: 0.5.0 is the version whose behaviour is documented above. A bump may
# add --exclude and make part of this setup unnecessary - check before upgrading.
RUN go install github.com/go-gremlins/gremlins/cmd/gremlins@v0.5.0

# Same non-root uid as the test image's plugin user, so anything this container
# writes into a mounted volume stays consistent with the rest of the stack.
RUN adduser -D -u 1002 mutant

WORKDIR /src
ENV CGO_ENABLED=1
ENV GOFLAGS=-buildvcs=false
# gremlins shells out to `go test`; give it a module cache it owns.
ENV GOPATH=/home/mutant/go
ENV GOCACHE=/home/mutant/.cache/go-build

USER mutant
