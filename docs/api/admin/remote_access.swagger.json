          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The trusted proxies in force, without the loopback baseline that is always\ntrusted: the panel's list when one is saved, else EVEY_TRUSTED_PROXIES."
        },
        "trustedProxiesFromPanel": {
          "type": "boolean",
          "description": "True when the list above comes from the panel rather than the environment."
        }
      }
