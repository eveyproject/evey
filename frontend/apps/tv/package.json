  "devDependencies": {
    "@react-native-tvos/config-tv": "0.1.6",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.14",
    "react-dom": "19.2.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
