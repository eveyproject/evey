test-results/

# Expo
frontend/apps/mobile/.expo/

# Dev scripts (local only) - except anything referenced from Makefile.
# "scripts/*" et pas "scripts/" : git refuse de ré-inclure quoi que ce soit
# sous un répertoire exclu, donc la forme avec / rendait les "!" ci-dessous
# inopérants pour tout nouveau fichier.
scripts/*
!scripts/i18n-fixture.py
!scripts/build-test-plugins.sh
!scripts/gen_cosign_fixtures.go
!scripts/verify-deploy.sh
# Operator scripts shipped with the docs (installation.md § 4, release.md).
!scripts/evey-update.sh
!scripts/evey-rollback.sh
!scripts/entrypoint-sim-test.sh
!scripts/tv/
!scripts/tv/*.sh
!scripts/tv/README.md
!scripts/bundle-budget.sh
!scripts/clean-checkout-guard.py
!scripts/hygiene-guard.py
!scripts/gate-receipt.py
!scripts/verify-commit.sh
# The shadow-exit corpus of ADR-0030 (temporary, goes with the shadow).
# ...mais jamais le compte de dev.
scripts/tv/.env

# Cosign test fixtures - private key must never be committed
tests/plugins/cosign/test.key
text

# plugin example builds
examples/plugins/*/node_modules/
examples/plugins/*/dist/

# ML intro-detection training labels (personal: library titles) - never committed
ml-trigger.txt

# Android release keystore - never committed (signing secret)
**/release.keystore

# ac3go WebAssembly decoder - built from the pinned module (go.mod tool), not committed.
frontend/apps/web/public/wasm/ac3go.wasm
frontend/apps/web/public/wasm/wasm_exec.js

# Local benchmark data (real library titles) - never tracked
bench/

