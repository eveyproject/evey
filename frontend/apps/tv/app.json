{
  "expo": {
    "name": "Evey TV",
    "slug": "evey-tv",
    "version": "0.1.23",
    "scheme": "evey",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "com.evey.tv",
      "isAppleTVOnly": true
    },
    "android": {
      "package": "com.evey.app",
      "versionCode": 90,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      }
    },
    "plugins": [
      "./plugins/withCleartextTraffic",
      "./plugins/withReleaseSigning",
      "./plugins/withR8Minify",
      [
        "./plugins/withUiScale",
        {
          "defaultPercent": 80
        }
      ],
      "./plugins/withSearchKey",
      "./plugins/withCastConnect",
      "./plugins/withNoAdId",
      "./plugins/withoutOfflineAudioService",
      "./plugins/withTvHardwareFeatures",
      "./plugins/withWidgetFocusGuard",
      "expo-router",
      "expo-video",
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true,
          "androidTVRequired": true,
          "androidTVBanner": "./assets/tv_banner.png"
        }
      ]
    ]
  }
}
