{
  "name": "@evey/client",
  "version": "0.1.0",
  "private": true,
  "description": "Platform-free hooks and logic shared by the web, mobile and TV clients",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@evey/api": "workspace:*",
    "@evey/media-caps": "workspace:*",
    "@evey/store": "workspace:*",
    "@evey/theme": "workspace:*",
    "@tanstack/react-query": "5.102.6",
    "hls.js": "1.6.16",
    "i18next": "26.4.0",
    "react": "19.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.14",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "exports": {
    ".": "./src/index.ts",
    "./native": "./src/native.ts",
    "./native/PluginWebView": "./src/native/PluginWebView.tsx",
    "./native/ThemeProvider": "./src/native/ThemeProvider.tsx",
    "./native/*": "./src/native/*.ts",
    "./web": "./src/web.ts",
    "./web/*": "./src/web/*.ts"
  }
}
