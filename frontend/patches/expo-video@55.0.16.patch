+  // Evey patch: the audio sink carries EveyAudioPreamp (VLC-style >100% gain
+  // inside OUR chain); setAudioProcessors keeps media3's default silence
+  // skipping + sonic processors after it.
+  private var renderersFactory = object : DefaultRenderersFactory(context) {
+    override fun buildAudioSink(
+      context: Context,
+      enableFloatOutput: Boolean,
+      enableAudioTrackPlaybackParams: Boolean
+    ): androidx.media3.exoplayer.audio.AudioSink {
+      return androidx.media3.exoplayer.audio.DefaultAudioSink.Builder(context)
+        .setEnableFloatOutput(enableFloatOutput)
+        .setEnableAudioTrackPlaybackParams(enableAudioTrackPlaybackParams)
+        .setAudioProcessors(arrayOf(EveyAudioPreamp.createProcessor()))
+        .build()
+    }
+
+    // Evey patch: the ac3go renderer (@evey/offline-audio) goes first, so it
+    // decodes AC-3/E-AC-3 ahead of MediaCodec unless the output takes the bitstream.
+    override fun buildAudioRenderers(
+      context: Context,
+      extensionRendererMode: Int,
+      mediaCodecSelector: androidx.media3.exoplayer.mediacodec.MediaCodecSelector,
+      enableDecoderFallback: Boolean,
+      audioSink: androidx.media3.exoplayer.audio.AudioSink,
+      eventHandler: android.os.Handler,
+      eventListener: androidx.media3.exoplayer.audio.AudioRendererEventListener,
+      out: java.util.ArrayList<androidx.media3.exoplayer.Renderer>
+    ) {
+      try {
+        out.add(
+          Class.forName("com.evey.offlineaudio.Ac3goAudioRenderer")
+            .getConstructor(
+              Context::class.java,
+              android.os.Handler::class.java,
+              androidx.media3.exoplayer.audio.AudioRendererEventListener::class.java,
+              androidx.media3.exoplayer.audio.AudioSink::class.java
+            )
+            .newInstance(context, eventHandler, eventListener, audioSink) as androidx.media3.exoplayer.Renderer
+        )
+      } catch (_: ClassNotFoundException) {
+      } catch (e: Exception) {
+        android.util.Log.w("EveyVideo", "ac3go audio renderer unavailable", e)
+      }
+      super.buildAudioRenderers(
+        context, extensionRendererMode, mediaCodecSelector, enableDecoderFallback,
+        audioSink, eventHandler, eventListener, out
+      )
+    }
+  }
     .forceEnableMediaCodecAsynchronousQueueing()
