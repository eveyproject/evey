    "/api/v1/admin/plugin-resource-limits": {
      "get": {
        "summary": "GetPluginResourceLimits returns the effective per-plugin resource caps the\nrunner is enforcing (env defaults overlaid with admin overrides).",
        "operationId": "AdminPluginService_GetPluginResourceLimits",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1PluginResourceLimits"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "AdminPluginService"
        ]
      },
      "put": {
        "summary": "UpdatePluginResourceLimits validates, persists and applies the per-plugin\nresource caps live: memory/PID/disk on the next monitor sweep, cpu_nice and\nsandbox_mode to plugins started afterwards. Returns the new effective caps.",
        "operationId": "AdminPluginService_UpdatePluginResourceLimits",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1PluginResourceLimits"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "PluginResourceLimits is the effective per-plugin cap set enforced by the\nrunner's resource monitor. Used as both the read response and the update\nrequest (server validates ranges and ignores out-of-range values).",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1PluginResourceLimits"
            }
          }
        ],
        "tags": [
          "AdminPluginService"
        ]
      }
    },
