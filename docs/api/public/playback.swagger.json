        "title": {
          "type": "string"
        },
        "isDefault": {
          "type": "boolean"
        },
        "isForced": {
          "type": "boolean"
        },
        "isExternal": {
          "type": "boolean"
        },
        "externalPath": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "format": "int32"
        },
        "height": {
          "type": "integer",
          "format": "int32"
        },
        "frameRate": {
          "type": "number",
          "format": "double"
        },
        "pixelFormat": {
          "type": "string"
        },
        "colorSpace": {
          "type": "string"
        },
        "colorTransfer": {
          "type": "string"
        },
        "colorPrimaries": {
          "type": "string"
        },
        "channels": {
          "type": "integer",
          "format": "int32"
        },
        "sampleRate": {
          "type": "integer",
          "format": "int32"
        },
        "bitDepth": {
          "type": "integer",
          "format": "int32"
