{
  "expo": {
    "name": "Evey",
    "slug": "evey",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "scheme": "evey",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.evey.app"
    },
    "android": {
      "package": "com.evey.app",
      "adaptiveIcon": {
        "backgroundColor": "#111827"
      }
    },
    "plugins": [
      "expo-router",
      ["expo-video", { "supportsPictureInPicture": true }],
      "expo-secure-store",
      "expo-image"
    ]
  }
}
