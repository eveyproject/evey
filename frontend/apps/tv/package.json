{
  "name": "tv",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "EXPO_TV=1 expo start",
    "android-tv": "EXPO_TV=1 expo run:android --device tv",
    "apple-tv": "EXPO_TV=1 expo run:ios --scheme tv",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
