{
  "name": "evey-plugin-weather",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/index.tsx --bundle --format=iife --target=es2020 --jsx=automatic --minify --outfile=dist/index.js --define:process.env.NODE_ENV=\\\"production\\\" --loader:.png=dataurl",
    "test": "vitest run --reporter=verbose"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1"
  },
  "comment": "Frontend libs are devDependencies on purpose: esbuild bundles them into dist/index.js at build time, so they must NOT ship in the plugin's runtime node_modules. Only the backend (main.js) runtime deps above are shipped - see scripts/build-test-plugins.sh, which prunes --omit=dev before zipping.",
  "devDependencies": {
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.17.10",
    "@react-three/postprocessing": "2.16.3",
    "postprocessing": "6.36.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "esbuild": "0.28.2",
    "typescript": "5.7.3",
    "vitest": "4.1.12"
  }
}
