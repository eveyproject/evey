            "name": "pluginId",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AdminPluginServiceApplyPluginUpdateBody"
            }
          }
        ],
        "tags": [
          "AdminPluginService"
        ]
