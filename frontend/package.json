{
  "name": "evey-frontend",
  "private": true,
  "scripts": {
    "web": "turbo run dev --filter=web",
    "mobile": "turbo run start --filter=mobile",
    "tv": "turbo run start --filter=tv",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "2.5.4",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@types/react": "19.2.14",
      "react": "19.2.0",
      "react-dom": "19.2.0",
      "react-native-worklets": "0.7.1"
    }
  }
}
