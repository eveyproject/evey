{
  "name": "evey-frontend",
  "private": true,
  "scripts": {
    "web": "turbo run dev --filter=web",
    "mobile": "turbo run start --filter=mobile",
    "tv": "turbo run start --filter=tv",
    "build": "turbo run build",
    "lint": "oxlint apps packages --deny-warnings && oxlint --react-plugin -A all -D react/rules-of-hooks apps packages && sh scripts/lint-hooks-suppressions.sh",
    "test": "vitest run",
    "typecheck": "turbo run typecheck",
    "gen:themes": "tsx packages/theme/gen-theme-css.mts"
  },
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "oxlint": "1.80.0",
    "turbo": "2.5.4",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@tanstack/react-query": "5.102.6",
      "@types/react": "19.2.14",
      "react": "19.2.0",
      "react-dom": "19.2.0",
      "react-native-worklets": "0.7.1"
    },
    "patchedDependencies": {
      "@kesha-antonov/react-native-background-downloader@4.5.4": "patches/@kesha-antonov__react-native-background-downloader@4.5.4.patch",
      "expo-video@55.0.16": "patches/expo-video@55.0.16.patch"
    }
  }
}
