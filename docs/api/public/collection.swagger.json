    },
    "v1GetCollectionItemsResponse": {
      "type": "object",
      "properties": {
        "mediaItemIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "total": {
          "type": "integer",
          "format": "int32"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1CollectionItemProto"
          }
        }
      }
    },
    "v1GetCollectionResponse": {
      "type": "object",
      "properties": {
        "collection": {
          "$ref": "#/definitions/v1CollectionProto"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1CollectionItemProto"
          },
          "description": "The members themselves, access- and parental-filtered like item_count.\nWithout them a client had to make a second call to show anything, and the\ntwo that did not made an empty page instead (found 2026-08-04)."
        },
        "total": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "v1ListCollectionsForMediaItemResponse": {
      "type": "object",
      "properties": {
        "collections": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1CollectionProto"
          }
        }
