{
  "name": "evey-frontend",
  "private": true,
  "scripts": {
    "web": "turbo run dev --filter=web",
    "mobile": "turbo run start --filter=mobile",
    "tv": "turbo run start --filter=tv",
    "build": "turbo run build",
    "lint": "oxlint apps packages --deny-warnings && oxlint --type-aware -c .oxlintrc.typeaware.json apps packages && oxlint --react-plugin -A all -D react/rules-of-hooks -D react/exhaustive-deps apps packages && sh scripts/lint-hooks-suppressions.sh",
    "test": "vitest run",
    "typecheck": "turbo run typecheck",
    "gen:themes": "tsx packages/theme/gen-theme-css.mts"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2004",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@tanstack/react-query": "5.102.6",
      "@types/react": "19.2.14",
      "react": "19.2.0",
      "react-dom": "19.2.0",
      "react-native-worklets": "0.7.1",
      "@babel/core@<7.29.6": "^7.29.6",
      "@xmldom/xmldom@<0.8.15": "^0.8.15",
      "baseline-browser-mapping@<2.11.0": "^2.11.0",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "brace-expansion@>=5.0.0 <5.0.12": "^5.0.12",
      "browserslist@<4.28.7": "^4.28.7",
      "compression@<1.8.2": "^1.8.2",
      "decode-uri-component@<0.5.1": "^0.5.1",
      "dompurify@<3.4.17": "^3.4.17",
      "fast-uri@<3.1.9": "^3.1.9",
      "follow-redirects@<1.16.1": "^1.16.1",
      "glob@>=9.0.0 <14.0.2": "^14.0.2",
      "js-yaml@<3.15.2": "^3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "linkify-it@<5.0.2": "^5.0.2",
      "lodash@<4.18.0": "^4.18.0",
      "markdown-it@<14.3.3": "^14.3.3",
      "minimatch@<11.0.1": "^11.0.1",
      "glob@7>minimatch": "3.1.2",
      "nanoid@<3.3.18": "^3.3.18",
