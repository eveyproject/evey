# Evey - development environment.
#
# Copy to .env.dev before the first `make dev`:
#
#     cp .env.dev.example .env.dev
#
# .env.dev is gitignored because it holds your own secrets and paths. Every
# make target that drives compose passes --env-file .env.dev, so the file has
# to exist or docker compose aborts before starting anything.
#
# This file holds only what must exist BEFORE the server boots. Everything an
# operator tunes afterwards - log level, language, transcoding limits, hardware
# acceleration, library watcher, plugin sandbox and quotas - lives in the admin
# panel (Admin > Server config), not here. Setting those as env vars only seeds
# a first boot.

# ── Required ──────────────────────────────────────────────────────────────────
# Compose refuses to start without these two (they use the `:?` form).
EVEY_DB_PASSWORD=dev-only-change-me
# Generate a real one with: openssl rand -hex 16
MEILI_MASTER_KEY=dev-only-change-me-openssl-rand-hex-16

# Where your media lives on the host. Read-write: the seek-index repair
# rebuilds files in place.
MEDIA_DIR=/path/to/your/media
# Up to three more host folders, mounted as /media2, /media3 and /media4
# in the dev container (each defaults to ./media when unset).
# MEDIA_DIR_2=/path/to/your/series
# MEDIA_DIR_3=/path/to/your/photos
# MEDIA_DIR_4=/path/to/your/music

# ── Compose profiles ──────────────────────────────────────────────────────────
# Which optional dev services to bring up. `web` starts the Vite dev server;
# add `mobile` for the Metro bundler, `tv` for the TV app.
COMPOSE_PROFILES=web

# ── Ports (host side) ─────────────────────────────────────────────────────────
# Change any that collide with something already running locally.
EVEY_HTTP_PORT=9091
EVEY_SERVER_PORT=9090
WEB_PORT=5173
POSTGRES_PORT=5432
MEILI_PORT=7700
METRO_PORT=8081

# ── Database ──────────────────────────────────────────────────────────────────
EVEY_DB_USER=evey
EVEY_DB_NAME=evey
EVEY_DB_SSLMODE=disable

# ── Server identity ───────────────────────────────────────────────────────────
# Used to build absolute URLs (artwork, HLS, invite links). Must be reachable
# from whatever device you test with - a phone on the LAN cannot resolve
# localhost, so use the host's LAN address there.
EVEY_SERVER_BASE_URL=http://localhost:9091
EVEY_SERVER_NAME=Evey Dev

# ── Mail ──────────────────────────────────────────────────────────────────────
# The dev stack ships mailcatcher; these point at it. Open its web UI to read
# password-reset and invite mails - nothing leaves your machine.
EVEY_SMTP_HOST=evey-mailcatcher
EVEY_SMTP_PORT=1025
EVEY_SMTP_FROM=evey@example.invalid
EVEY_SMTP_TLS=none

# ── Metadata providers (optional) ─────────────────────────────────────────────
# Without these, scans still work but films and shows come back unenriched:
# no posters, no summaries, no cast. Free keys from themoviedb.org / omdbapi.com.
EVEY_TMDB_API_KEY=
EVEY_OMDB_API_KEY=

# ── Intro detection (optional) ────────────────────────────────────────────────
EVEY_INTRO_PROVIDERS_ENABLED=false
EVEY_INTRO_TIDB_API_KEY=

# ── Plugins ───────────────────────────────────────────────────────────────────
EVEY_PLUGINS_ENABLED=true

# ── File ownership ────────────────────────────────────────────────────────────
# Make the container write files as you, so anything it creates under MEDIA_DIR
# or the data volumes stays editable from the host. `id -u` / `id -g`.
PUID=1000
PGID=1000
UID=1000
GID=1000
