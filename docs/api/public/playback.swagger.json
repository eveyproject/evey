    "/api/v1/playback/{mediaItemId}/stream-info": {
      "get": {
        "operationId": "PlaybackService_GetStreamInfo",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1StreamInfo"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "mediaItemId",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "deviceId",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "maxBitrate",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "maxWidth",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "maxHeight",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "supportedCodecs",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string"
            },
            "collectionFormat": "multi"
          },
          {
            "name": "supportedContainers",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string"
            },
            "collectionFormat": "multi"
          },
          {
            "name": "audioStreamIndex",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "subtitleStreamIndex",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "supportedAudioCodecs",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string"
            },
            "collectionFormat": "multi"
          },
          {
            "name": "networkType",
            "description": "network_type hints the active client connection (\"wifi\" or \"cellular\").\nEmpty defaults to wifi. When \"cellular\", the profile's\nmax_bitrate_cellular_kbps preference (if set) caps the stream.",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "supportsHdr",
            "description": "supports_hdr signals the client display can render HDR (HDR10/HLG) natively.\nThe web player sets it from the (dynamic-range: high) media query. When\nfalse (the default), an HDR source is transcoded/tonemapped to SDR; when\ntrue, an HDR10/HLG source can direct-play / remux. Dolby Vision always\ntranscodes regardless (a single bool can't distinguish a DoVi-capable\npanel from an HDR10-only one).",
            "in": "query",
            "required": false,
            "type": "boolean"
          },
          {
            "name": "wasmAudio",
            "description": "wasm_audio: the client decodes AC-3/E-AC-3 itself (ac3go), same capability\nas ?wasmAudio=1 on the master. Needs its own field - such a client must not\nadvertise those codecs in supported_audio_codecs (MSE refuses them muxed).",
            "in": "query",
            "required": false,
            "type": "boolean"
          },
          {
            "name": "fmp4AudioPassthrough",
            "description": "fmp4_audio_passthrough: audio codecs the client accepts as a RAW\npassthrough inside our fMP4 segments, beyond the always-wired\nAAC/AC-3/E-AC-3. Separate from supported_audio_codecs on purpose:\n\"I decode MP3\" and \"I accept MP3 muxed in fMP4\" are different questions,\nand the web player declares the first unconditionally while AVPlayer\nrefuses the second. Only \"mp3\" is honoured today; anything else is\nignored server-side. Empty (older clients) keeps the previous behaviour,\na server-side re-encode to AAC.",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string"
            },
            "collectionFormat": "multi"
          },
          {
            "name": "maxH264Level",
            "description": "max_h264_level: the highest H.264 level_idc the device decodes (41 = 4.1,\n51 = 5.1). Same meaning as ?maxH264Level= on the HLS master. 0 (older\nclients) leaves the decision level-blind, as before.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "maxH264Height",
            "description": "max_h264_height: the tallest H.264 picture the device decodes, when its\nH.264 decoder stops below max_height (a Chromecast Ultra plays 2160p HEVC\nbut 1080p H.264). Same meaning as ?maxH264Height= on the HLS master. 0\n(older clients, most devices) = no separate limit.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "PlaybackService"
        ]
      }
    },
