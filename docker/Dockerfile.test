# Debian base (NOT Alpine): evey uses jellyfin-ffmpeg everywhere (tonemapx + HLS
# patches, parity with prod), and jellyfin-ffmpeg7 ships ONLY as a Debian package.
# Debian glibc also matches prod for the CGO_ENABLED=1 test build.
FROM golang:1.27.0-trixie

# No docker CLI: the testcontainers-based tests talk to the mounted docker.sock
# via the Go SDK, and nothing shells out to a `docker` binary. Debian's docker.io
# ships only the daemon (dockerd/containerd), not the client - pure bloat here.
RUN apt-get update && apt-get -y upgrade && apt-get install -y --no-install-recommends \
    gcc libc6-dev \
    libchromaprint-tools \
    git \
    ca-certificates curl gnupg \
    && rm -rf /var/lib/apt/lists/*

# jellyfin-ffmpeg7 - the ONLY ffmpeg (parity with prod; no Debian/vanilla ffmpeg).
RUN install -d /etc/apt/keyrings \
    && curl -fsSL https://repo.jellyfin.org/jellyfin_team.gpg.key \
         | gpg --dearmor -o /etc/apt/keyrings/jellyfin.gpg \
    && printf 'Types: deb\nURIs: https://repo.jellyfin.org/debian\nSuites: trixie\nComponents: main\nSigned-By: /etc/apt/keyrings/jellyfin.gpg\n' \
         > /etc/apt/sources.list.d/jellyfin.sources \
    && apt-get update && apt-get install -y --no-install-recommends jellyfin-ffmpeg7 \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/lib/jellyfin-ffmpeg/ffmpeg  /usr/local/bin/ffmpeg \
    && ln -sf /usr/lib/jellyfin-ffmpeg/ffprobe /usr/local/bin/ffprobe

RUN useradd -u 1001 -g root -M -s /usr/sbin/nologin evey-plugin

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

ENV CGO_ENABLED=1
ENV GOFLAGS=-buildvcs=false
ENV TESTCONTAINERS_RYUK_DISABLED=true
ENV TESTCONTAINERS_HOST_OVERRIDE=host.docker.internal

RUN git config --global --add safe.directory /app
