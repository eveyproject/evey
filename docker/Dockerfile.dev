FROM golang:1.27.0-trixie

# Full HW transcode parity with prod (one-image model): the SAME
# NVENC/VAAPI/QSV ffmpeg + VA/oneVPL driver set as the runtime image, so the dev
# container exercises the real GPU path - NVENC on this box, VAAPI/QSV greyed on
# WSL2 (Mesa d3d12 can't sustain the multi-variant encode). One dev container
# replaces the old Alpine-software + glibc-HW split. gcc/libc6-dev STAY here
# (unlike the lean prod image): Air rebuilds the Landlock LD_PRELOAD .so on every
# reload (see .air.toml) and the pluginrunner red-team tests need `cc` + `node`.
# intel-media-va-driver-non-free lives in non-free; enable it on the deb822
# sources before apt. postgresql-client-17 dumps the PG16 dev server fine.
RUN sed -i 's/Components: main/Components: main contrib non-free non-free-firmware/' \
        /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get -y upgrade && apt-get install -y --no-install-recommends \
       libchromaprint-tools curl postgresql-client-17 gcc libc6-dev \
       python3 python3-pip python3-grpcio python3-protobuf \
       nodejs npm tzdata bash perl lua5.4 ruby php-cli \
       bubblewrap git \
       vainfo libva2 libva-drm2 mesa-va-drivers \
       intel-media-va-driver-non-free i965-va-driver libvpl2 libmfx-gen1.2 \
    && rm -rf /var/lib/apt/lists/* \
    && ([ -e /usr/bin/node ] || ln -sf /usr/bin/nodejs /usr/bin/node) \
    && ([ -e /usr/bin/lua ] || ln -sf /usr/bin/lua5.4 /usr/bin/lua) \
    && go install github.com/air-verse/air@latest \
    && go install github.com/bufbuild/buf/cmd/buf@v1.47.2 \
    && go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.13.2 \
    && go install golang.org/x/vuln/cmd/govulncheck@latest \
    && npm install -g esbuild@0.25.12 @grpc/grpc-js@1.12.6 @grpc/proto-loader@0.7.13

# jellyfin-ffmpeg7 - REAL parity with the prod runtime (the comment at the top of
# this file is only TRUE with this block). The standalone jellyfin-ffmpeg7 package
# carries the `tonemapx` HDR filter + the muxer/HLS patches absent from Debian's
# ffmpeg; it is the ONLY ffmpeg CLI here (the Debian `ffmpeg` package is not
# installed - same as the prod runtime; libav* still ship via libchromaprint-tools).
# Same install as the prod Dockerfile. Without it, local transcode/HLS validation
# runs on a DIFFERENT binary than prod (Debian zscale, no tonemapx, different muxer).
# CAVEAT: this is BINARY parity, NOT silicon parity. The reference box is an
# old iGPU (VAAPI encode only, NO HEVC HW decode); this dev host is not. So
# SOFTWARE/muxer/remux results validated here transfer to prod, but HW-accel
# (NVENC/VAAPI/QSV) results do NOT - those need the actual prod GPU. What ships
# is the weak NAS.
RUN apt-get update && apt-get install -y --no-install-recommends gnupg \
    && install -d /etc/apt/keyrings \
    && curl -fsSL https://repo.jellyfin.org/jellyfin_team.gpg.key \
         | gpg --dearmor -o /etc/apt/keyrings/jellyfin.gpg \
    && printf 'Types: deb\nURIs: https://repo.jellyfin.org/debian\nSuites: trixie\nComponents: main\nSigned-By: /etc/apt/keyrings/jellyfin.gpg\n' \
         > /etc/apt/sources.list.d/jellyfin.sources \
    && apt-get update && apt-get install -y --no-install-recommends jellyfin-ffmpeg7 \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/lib/jellyfin-ffmpeg/ffmpeg  /usr/local/bin/ffmpeg \
    && ln -sf /usr/lib/jellyfin-ffmpeg/ffprobe /usr/local/bin/ffprobe \
    && /usr/local/bin/ffmpeg -hide_banner -version >/dev/null \
    && /usr/local/bin/ffmpeg -hide_banner -filters | grep -q tonemapx

# cosign - Debian has no apt package; ride the official ko-built image (pinned).
# Matches the prod runtime so the plugin signature path is testable in dev.
COPY --from=gcr.io/projectsigstore/cosign:v2.4.1 /ko-app/cosign /usr/local/bin/cosign

# NVENC: the NVIDIA Container Toolkit injects libnvidia-encode when the compose
# service reserves a GPU (NVIDIA_DRIVER_CAPABILITIES must include `video`).
# Harmless when no GPU is mapped - the server falls back to software.
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=all
ENV TZ=Europe/Paris

# /app is bind-mounted from the host where ownership is the host UID (1000),
# not root (the container default). Git 2.36+ refuses to read such repos as
# "dubious ownership" - opt in explicitly so `make ci-fast` can compute
# --new-from-rev for the golangci-lint ratchet.
RUN git config --global --add safe.directory /app

RUN useradd -u 1001 -g root -m -s /usr/sbin/nologin evey-plugin

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

# mkvgo CLI, same recipe as prod (Dockerfile:53-58): the pinned library ships a
# command; the admin shell's mkvgo submenu and `evey admin doctor` expect it.
RUN CGO_ENABLED=0 go build \
      -ldflags="-s -w -X main.version=$(go list -m -f '{{.Version}}' github.com/gravity-zero/mkvgo)" \
      -o /usr/local/bin/mkvgo github.com/gravity-zero/mkvgo/cmd/mkvgo

# Same admin shell as prod (Dockerfile:224-234), sourced live from the bind mount so edits need no rebuild.
RUN ln -sf /app/tmp/evey /usr/local/bin/evey \
    && printf '\n# Evey admin shell: CLI completion + interactive launcher\nfor _f in /app/cmd/evey/evey-completion.bash /app/docker/mkvgo-completion.bash; do [ -r "$_f" ] && . "$_f"; done\n[ -r /app/docker/evey-shell.sh ] && . /app/docker/evey-shell.sh\n' >> /etc/bash.bashrc

ENV EVEY_LOG_DEV_MODE=true

CMD ["sh", "-c", "buf generate && air -c .air.toml"]
