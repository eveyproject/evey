<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.CAMERA"/>
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
  <!-- Android 13+: without this the Cast SDK's media notification (a
       foreground service) cannot show, Android freezes the app ~60s after
       the screen turns off, and receivers that do not survive losing their
       sender (an operator box, 2026-07-26) cut the playback. The runtime
       request lives in lib/castNotificationPermission.ts. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <!-- Permission du service declare plus bas. Depuis targetSdk 34 un service
       de premier plan doit annoncer son type ET detenir la permission
       correspondante, sinon Android refuse son demarrage. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
  <!-- Verrous tenus pendant une session Cast par cast/CastKeepAlive.kt. Un
       service de premier plan empeche le GEL du processus mais ne retient pas
       le CPU : ecran eteint, le CPU se suspend, les PONG du heartbeat CASTV2
       ne partent plus, la box ferme la socket sender et demonte le recepteur
       (mesure prod 2026-07-28 : mort de la TV 3 min 40 apres le silence du
       telephone). Le wakelock partiel est la piece porteuse, c'est ce que
       tient un client Android Cast tres repandu ; le WifiLock est la ceinture en plus. -->
  <uses-permission android:name="android.permission.WAKE_LOCK"/>
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" tools:replace="android:maxSdkVersion"/>
  <!-- The app never records audio (expo-camera is only used for QR barcode
       scanning, expo-audio only for playback) - but expo-audio and expo-camera
       each bundle RECORD_AUDIO unconditionally in their own module manifest,
       so a plain omission here would still be merged in. tools:node="remove"
       is required to actually strip it from the final APK. -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove"/>
  <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
  <uses-permission android:name="android.permission.USE_FINGERPRINT"/>
  <uses-permission android:name="android.permission.VIBRATE"/>
  <!-- Legacy (API<=32) scoped write, required by expo-file-system (download
       cache) and expo-image-picker (avatar upload); both bundle it themselves. -->
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" tools:replace="android:maxSdkVersion"/>
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <category android:name="android.intent.category.BROWSABLE"/>
      <data android:scheme="https"/>
    </intent>
  </queries>
  <application android:name=".MainApplication" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="true" android:theme="@style/AppTheme" android:supportsRtl="true" android:enableOnBackInvokedCallback="false" android:fullBackupContent="@xml/secure_store_backup_rules" android:dataExtractionRules="@xml/secure_store_data_extraction_rules" android:usesCleartextTraffic="true">
    <!-- Notre OptionsProvider (Cast Connect) : celui du paquet, plus
         setAndroidReceiverCompatible(true), voir cast/EveyCastOptionsProvider.kt.
         Ce manifeste est tenu a la main (pas de prebuild), la ligne est donc
         ecrite ici en plus du plugin withCastConnectSender. -->
    <meta-data android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME" android:value="com.evey.app.cast.EveyCastOptionsProvider"/>
    <!-- Custom Evey Web Receiver (Cast Console D36A449B, https://cast.eveyproject.org):
         probes its capabilities on the TV and decodes AC-3 in wasm. While the app
         console is Unpublished, only registered test devices load it - publish
         before distributing this APK. -->
    <meta-data android:name="com.reactnative.googlecast.RECEIVER_APPLICATION_ID" android:value="D36A449B"/>
    <!-- Le Cast SDK PORTE la classe MediaNotificationService mais ne la
         declare dans aucun de ses AAR (play-services-cast-framework 22.3.1 ne
         declare que MediaIntentReceiver et ReconnectionService) : c'est a
         l'app de le faire. Sans cette ligne le service ne demarre jamais, la
         notification media Cast n'existe pas, et rien n'empeche Android de
         geler l'app des qu'elle quitte le premier plan - le recepteur perd
         alors son sender et la box le demonte (prod 2026-07-28 18:40 UTC :
         ReportProgress mort net 21 s apres le debut du cast, reprise a la
         reactivation de l'ecran a 18:53:16). C'est le chainon qui manquait a
         POST_NOTIFICATIONS ajoutee en beta.12. -->
    <service android:name="com.google.android.gms.cast.framework.media.MediaNotificationService" android:exported="false" android:foregroundServiceType="mediaPlayback"/>
    <!-- GoogleCastOptionsProvider (react-native-google-cast) appelle
         setExpandedControllerActivityClassName() SANS condition, alors que le
         plugin expo du paquet ne declare cette activite que si on lui passe
         expandedController: true. La notification media du SDK visait donc un
         composant absent du manifeste. On la declare pour que la pile Cast
         soit complete plutot que d'a moitie exister. -->
    <activity android:name="com.reactnative.googlecast.RNGCExpandedControllerActivity" android:exported="false"/>
    <meta-data android:name="expo.modules.updates.ENABLED" android:value="false"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_CHECK_ON_LAUNCH" android:value="ALWAYS"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS" android:value="0"/>
    <activity android:name=".MainActivity" android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|smallestScreenSize|locale|layoutDirection" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.App.SplashScreen" android:exported="true" android:screenOrientation="unspecified" android:supportsPictureInPicture="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="evey"/>
      </intent-filter>
    </activity>
  </application>
</manifest>