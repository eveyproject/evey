    "v1MediaStreamType": {
      "type": "string",
      "enum": [
        "MEDIA_STREAM_TYPE_UNSPECIFIED",
        "MEDIA_STREAM_TYPE_VIDEO",
        "MEDIA_STREAM_TYPE_AUDIO",
        "MEDIA_STREAM_TYPE_SUBTITLE",
        "MEDIA_STREAM_TYPE_ATTACHMENT"
      ],
      "default": "MEDIA_STREAM_TYPE_UNSPECIFIED"
    },
    "v1PaginationRequest": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "format": "int32"
        },
        "pageSize": {
          "type": "integer",
          "format": "int32"
        },
        "cursor": {
          "type": "string",
          "description": "Opaque keyset cursor returned by a previous PaginationResponse. When\nset, server uses keyset pagination instead of offset and ignores\n`page` - guarantees no skips/duplicates under concurrent writes."
        }
      }
    },
    "v1PaginationResponse": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "format": "int32"
        },
        "pageSize": {
          "type": "integer",
          "format": "int32"
        },
        "totalItems": {
          "type": "integer",
          "format": "int32"
        },
        "totalPages": {
          "type": "integer",
          "format": "int32"
        },
        "nextCursor": {
          "type": "string",
          "description": "Opaque cursor for the next page. Empty when no more pages or when\nthe server fell back to offset pagination."
        }
      }
    },
    "v1PersonType": {
      "type": "string",
      "enum": [
        "PERSON_TYPE_UNSPECIFIED",
        "PERSON_TYPE_ACTOR",
        "PERSON_TYPE_DIRECTOR",
        "PERSON_TYPE_WRITER",
        "PERSON_TYPE_PRODUCER",
        "PERSON_TYPE_COMPOSER",
        "PERSON_TYPE_GUEST_STAR"
      ],
      "default": "PERSON_TYPE_UNSPECIFIED"
    },
    "v1PlayMethod": {
      "type": "string",
      "enum": [
        "PLAY_METHOD_UNSPECIFIED",
        "PLAY_METHOD_DIRECT_PLAY",
        "PLAY_METHOD_DIRECT_STREAM",
        "PLAY_METHOD_TRANSCODE"
      ],
      "default": "PLAY_METHOD_UNSPECIFIED"
    },
    "v1PlaySession": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "profileId": {
          "type": "string"
        },
        "mediaItemId": {
          "type": "string"
        },
        "playMethod": {
          "$ref": "#/definitions/v1PlayMethod"
        },
        "deviceId": {
          "type": "string"
        },
        "deviceName": {
          "type": "string"
        },
        "clientName": {
          "type": "string"
        },
        "positionMs": {
          "type": "string",
          "format": "int64"
        },
        "isPaused": {
          "type": "boolean"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "v1Rating": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
